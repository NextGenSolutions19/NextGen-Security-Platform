# Local development environment for the mobile app.
# Copy from ../../.env.example and configure as needed.

EXPO_PUBLIC_APP_ENV=development
# Dev OTP hint works only in __DEV__ builds, even if this flag is true.
# Set EXPO_PUBLIC_DEV_OTP_CLIENT_TOKEN to the same value as the hosted
# VISITOR_OTP_DEV_CLIENT_TOKEN secret for localhost QA.
EXPO_PUBLIC_ENABLE_DEV_OTP_HINT=true
EXPO_PUBLIC_DEV_OTP_CLIENT_TOKEN=
# Mock login works only in __DEV__ builds, even if this flag is true.
EXPO_PUBLIC_ENABLE_DEV_MOCK_AUTH=true
EXPO_PUBLIC_DEV_MOCK_SOCIETY_CODE=DEMO
EXPO_PUBLIC_DEV_MOCK_SOCIETY_NAME=Demo Residential Society
EXPO_PUBLIC_DEV_MOCK_GUARD_LOGIN_ID=GUARD01
EXPO_PUBLIC_DEV_MOCK_GUARD_PASSWORD=
EXPO_PUBLIC_DEV_MOCK_ADMIN_LOGIN_ID=ADMIN01
EXPO_PUBLIC_DEV_MOCK_ADMIN_PASSWORD=
