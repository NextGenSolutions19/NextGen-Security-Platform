# =============================================================================
# NextGen Security Platform — Environment Variables (Example)
# =============================================================================
# Copy to .env and fill in values. NEVER commit real secrets.
# Service-role keys and operator secrets belong ONLY in server/operator environments.
# =============================================================================

# --- Mobile app (client-safe / EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development

# --- Development OTP hint (optional — localhost QA only) ---
# Works only in __DEV__ builds, even if this flag is true.
# Must match the server-side VISITOR_OTP_DEV_CLIENT_TOKEN secret.
EXPO_PUBLIC_ENABLE_DEV_OTP_HINT=false
EXPO_PUBLIC_DEV_OTP_CLIENT_TOKEN=

# --- Development mock auth (optional — for local UI testing without Supabase) ---
# Never enable in production builds.
EXPO_PUBLIC_ENABLE_DEV_MOCK_AUTH=false
EXPO_PUBLIC_DEV_MOCK_SOCIETY_CODE=
EXPO_PUBLIC_DEV_MOCK_SOCIETY_NAME=
EXPO_PUBLIC_DEV_MOCK_GUARD_LOGIN_ID=
EXPO_PUBLIC_DEV_MOCK_GUARD_PASSWORD=
EXPO_PUBLIC_DEV_MOCK_ADMIN_LOGIN_ID=
EXPO_PUBLIC_DEV_MOCK_ADMIN_PASSWORD=

# --- Operator tooling (platform/scripts — local machine / CI secrets only) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Edge Functions (set via Supabase CLI secrets — not in mobile app) ---
# Production must leave VISITOR_OTP_DEV_EXPOSE_CODE unset or false.
# OTP codes are returned only when ALL of the following are true:
#   VISITOR_OTP_DEV_EXPOSE_CODE=true
#   VISITOR_OTP_SMS_PROVIDER is missing or "dev"
#   request includes dev_otp_client_token matching VISITOR_OTP_DEV_CLIENT_TOKEN
# The mobile app sends that token only in __DEV__ builds with
# EXPO_PUBLIC_ENABLE_DEV_OTP_HINT=true and EXPO_PUBLIC_DEV_OTP_CLIENT_TOKEN set.
# VISITOR_OTP_SMS_PROVIDER=dev
# VISITOR_OTP_DEV_EXPOSE_CODE=true
# VISITOR_OTP_DEV_CLIENT_TOKEN=
# OTP_HMAC_SECRET=
# EXPO_ACCESS_TOKEN=
